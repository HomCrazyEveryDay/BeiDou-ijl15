#!/bin/sh
msg_file="$1"

subject=
cr=$(printf '\r')
bom=$(printf '\357\273\277')
while IFS= read -r line || [ -n "$line" ]; do
  line=${line%"$cr"}
  case "$line" in
    ""|\#*) continue ;;
  esac
  subject=$line
  break
done < "$msg_file"
subject=${subject#"$bom"}

case "$subject" in
  fix:\ *|fix\(*\):\ *|feat:\ *|feat\(*\):\ *|docs:\ *|docs\(*\):\ *|chore:\ *|chore\(*\):\ *|refactor:\ *|refactor\(*\):\ *|test:\ *|test\(*\):\ *|build:\ *|build\(*\):\ *|ci:\ *|ci\(*\):\ *|perf:\ *|perf\(*\):\ *|style:\ *|style\(*\):\ *|Merge\ *|Revert\ *|fixup\!\ *|squash\!\ *) ;;
  *)
    echo "提交标题需使用 Conventional Commit，例如 fix: 修复说明或 feat(scope): 功能说明" >&2
    exit 1
    ;;
esac

exit 0
